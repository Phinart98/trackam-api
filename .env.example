# ── Supabase ──────────────────────────────────────────────────────────────────
# Use transaction pooler (port 6543) with prepareThreshold=0 for Cloud Run compatibility
SUPABASE_JDBC_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:6543/postgres?prepareThreshold=0
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings-api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# ── AI Providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key
GEMINI_API_KEY=AIza_your-gemini-api-key
CEREBRAS_API_KEY=csk-your-cerebras-api-key

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://trackam.vercel.app

# ── Admin (your Supabase user UUID — used to protect /api/admin/metrics) ─────
# Find it: Supabase Dashboard → Authentication → Users → your email → UID column
TRACKAM_ADMIN_USER_ID=
